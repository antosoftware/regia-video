<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Permette alla WebView (motore JavaScript) di usare il compilatore
         JIT: senza questo permesso, macOS esegue tutto il JavaScript
         dell'app in modalità "interpretata", molto più lenta — è questa
         la causa dell'app generalmente più lenta/pesante nella build
         rispetto al dev. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
